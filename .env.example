# ============================================================================
# CIBERCENTINELA - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Renombrar a .env y ajustar con credenciales locales antes de iniciar.
# ============================================================================

# Configuración del Demonio Local (Background Service)
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8090
DAEMON_INTERVAL_SEC=15

# Servidor de Base de Datos MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cibercentinela_db

# Cuentas de Servicio por Rol (Principio de Menor Privilegio - RBAC MySQL 8.0)
DB_ADMIN_USER=usr_admin_ciber
DB_ADMIN_PASS=TuPasswordAdminSegura123!

DB_ANALYST_USER=usr_analista_ciber
DB_ANALYST_PASS=TuPasswordAnalistaSegura123!

DB_REPORTER_USER=usr_reportador_ciber
DB_REPORTER_PASS=TuPasswordReportadorSegura123!

# Cuenta de Respaldo en Caliente (mysqldump --single-transaction)
DB_BACKUP_USER=root
DB_BACKUP_PASS=TuPasswordRootMySQL
MYSQLDUMP_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# Rutas del Sistema Forense y Respaldos (Retención 7 días)
FORENSICS_STORAGE_ROOT=./srv/forensics/cases
BACKUP_STORAGE_ROOT=./var/backups/mysql_cibercentinela
BACKUP_RETENTION_DAYS=7

# Integración con API de Telegram (Alertas de Severidad Crítica)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SIMULATION_MODE=true

# Secreto criptográfico de sesión del demonio
SESSION_SECRET_KEY=GenerarClaveAleatoriaSecretaDeAlMenos32Caracteres

# Google reCAPTCHA v2 (Protección Anti-Bot)
RECAPTCHA_SITE_KEY=tu_clave_de_sitio_publica_aqui
RECAPTCHA_SECRET_KEY=tu_clave_secreta_privada_aqui
